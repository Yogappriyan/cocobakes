rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'pornimakannan98@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health / connection test
    match /test/connection {
      allow read: if true;
    }

    // Admin directory
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow write: if isAdmin() && isValidId(productId);
    }

    // Categories catalog
    match /categories/{categoryId} {
      allow get: if isValidId(categoryId);
      allow list: if true;
      allow write: if isAdmin() && isValidId(categoryId);
    }

    // Promotional Coupons
    match /coupons/{couponId} {
      allow get: if isValidId(couponId);
      allow list: if true;
      allow write: if isAdmin() && isValidId(couponId);
    }

    // Storefront Settings
    match /site_settings/{docId} {
      allow get: if isValidId(docId);
      allow list: if true;
      allow write: if isAdmin() && isValidId(docId);
    }

    // Reviews & Testimonials
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isValidId(reviewId)
                    && request.resource.data.rating is number
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5
                    && request.resource.data.comment is string
                    && request.resource.data.comment.size() <= 2000;
      allow update, delete: if true;
    }

    // Inquiries and Contact Messages
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId)
                    && request.resource.data.name is string
                    && request.resource.data.name.size() <= 150
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.message is string
                    && request.resource.data.message.size() <= 3000;
      allow get, list, update, delete: if true;
    }

    // Orders Collection
    match /orders/{orderId} {
      allow get, list: if true;
      allow create: if isValidId(orderId);
      allow update, delete: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isValidId(userId) && (isAdmin() || (isSignedIn() && request.auth.uid == userId));
      allow create, update: if isValidId(userId) && (
        isAdmin() || (
          isSignedIn() && 
          request.auth.uid == userId && 
          (!('role' in request.resource.data) || request.resource.data.role == 'customer')
        )
      );
      allow delete: if isAdmin() && isValidId(userId);
    }
  }
}
